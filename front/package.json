		"@react-router/node": "^7.0.1",
		"@react-router/serve": "^7.0.1",
		"@tabler/icons-react": "^3.22.0",
		"isbot": "^5.1.17",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"react-router": "^7.0.1"
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"@react-router/dev": "7.18.3",
		"@types/node": "22.20.1",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.7",
		"@vitejs/plugin-react": "4.7.0",
		"@vitest/browser": "2.1.9",
		"autoprefixer": "10.5.4",
		"playwright": "1.62.1",
